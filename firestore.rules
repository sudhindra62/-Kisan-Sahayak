rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * USER-OWNED DATA SECURITY POLICY
     * This rule ensures that farmers can only read or write their own data.
     * Access is restricted based on the Firebase Authentication UID.
     * Deployment ID: secure-isolation-v1-2024
     */
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global deny for any paths not explicitly matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}